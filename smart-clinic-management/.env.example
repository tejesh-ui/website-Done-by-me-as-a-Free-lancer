# ============================================================
# SMART CLINIC MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================

# Supabase Project Connection
# Obtain these from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Clinic Application Settings
VITE_APP_NAME=Smart Clinic Management System
VITE_APP_TIMEZONE=Asia/Kolkata
VITE_DEFAULT_CURRENCY=INR

# WhatsApp Business Cloud API (Official Meta Provider)
# Leave blank or unconfigured to display "Not Configured" accurately
VITE_WHATSAPP_API_URL=https://graph.facebook.com/v18.0
VITE_WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
VITE_WHATSAPP_ACCESS_TOKEN=your-whatsapp-permanent-access-token

# SMS Gateway (Fast2SMS / Twilio / MSG91)
VITE_SMS_API_KEY=your-sms-api-key
VITE_SMS_SENDER_ID=AROGYA

# Email Service (Resend / SMTP)
VITE_RESEND_API_KEY=re_your_api_key_here
VITE_EMAIL_FROM="Arogya Smart Clinic <notifications@arogyaclinic.in>"
